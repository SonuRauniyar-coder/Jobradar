# Copy to .env and replace every value before running docker compose.
DB_USERNAME=jobradar
DB_PASSWORD=change-me
# At least 32 characters, e.g. the output of: openssl rand -base64 48
JWT_SECRET=change-me-to-a-long-random-string-of-32-or-more-chars
ADMIN_EMAIL=you@example.com
ADMIN_PASSWORD=change-me

# Daily rescan, Spring cron format, evaluated in SCAN_ZONE (default Asia/Kolkata)
SCAN_CRON=0 0 6 * * *

# Optional email digest
MAIL_ENABLED=false
MAIL_FROM=
MAIL_TO=
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
